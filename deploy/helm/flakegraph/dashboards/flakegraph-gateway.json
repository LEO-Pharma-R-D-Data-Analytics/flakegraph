    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flakegraph-postgres"
      },
      "description": "Prompt plus completion tokens per interval, summed from LiteLLM's spend log. Survives proxy restarts, unlike the counters above.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "id": 11,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flakegraph-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(s.\"startTime\", $__interval),\n       COALESCE(NULLIF(t.key_alias, ''), NULLIF(s.metadata->>'user_api_key_alias', ''), 'unknown') AS metric,\n       sum(s.total_tokens) AS value\nFROM litellm.\"LiteLLM_SpendLogs\" AS s\nLEFT JOIN litellm.\"LiteLLM_VerificationToken\" AS t ON t.token = s.api_key\nWHERE $__timeFilter(s.\"startTime\")\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Tokens by key alias",
      "type": "timeseries"
    },
