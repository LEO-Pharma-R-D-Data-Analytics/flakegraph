          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(flakegraph_ocr_requests_total{namespace=\"$namespace\", consumer_class=~\"$consumer_class\", outcome!=\"succeeded\"}[$__rate_interval])) / sum(rate(flakegraph_ocr_requests_total{namespace=\"$namespace\", consumer_class=~\"$consumer_class\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "not succeeded",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(flakegraph_ocr_requests_total{namespace=\"$namespace\", consumer_class=~\"$consumer_class\", outcome=~\"upstream_.*\"}[$__rate_interval])) / sum(rate(flakegraph_ocr_requests_total{namespace=\"$namespace\", consumer_class=~\"$consumer_class\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "upstream failures",
          "range": true,
