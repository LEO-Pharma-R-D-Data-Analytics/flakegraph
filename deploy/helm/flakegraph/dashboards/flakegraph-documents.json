    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flakegraph-postgres"
      },
      "description": "Live rows of the shared queue in dispatch order (lower priority value first). A stale heartbeat means the owning shim replica has gone; its rows are reaped on the next sweep.",
