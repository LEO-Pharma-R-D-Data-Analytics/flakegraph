        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (stage, status) (cnpg_flakegraph_tasks_count{namespace=\"$namespace\", status=~\"queued|running\"})",
          "instant": false,
          "legendFormat": "{{stage}} {{status}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Open tasks by stage",
      "type": "timeseries"
    },
