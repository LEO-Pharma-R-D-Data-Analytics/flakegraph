        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "id": 14,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flakegraph-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(completed_at, $__interval),\n       stage || ' p50' AS metric,\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY\n           extract(epoch FROM completed_at - started_at))\n           AS value\nFROM flakegraph_task\nWHERE $__timeFilter(completed_at) AND status = 'succeeded'\n  AND started_at IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flakegraph-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(completed_at, $__interval),\n       stage || ' p95' AS metric,\n       percentile_cont(0.95) WITHIN GROUP (ORDER BY\n           extract(epoch FROM completed_at - started_at))\n           AS value\nFROM flakegraph_task\nWHERE $__timeFilter(completed_at) AND status = 'succeeded'\n  AND started_at IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "B"
        }
      ],
      "title": "Task duration by stage",
      "type": "timeseries"
    },
