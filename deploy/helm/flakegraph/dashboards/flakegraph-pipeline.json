          "editorMode": "code",
          "expr": "sum by (pool) (label_replace(kube_deployment_status_replicas_available{namespace=\"$namespace\", deployment=~\".*-(prepare|extract|finalize)$\"}, \"pool\", \"$1\", \"deployment\", \".*-(prepare|extract|finalize)$\"))",
          "instant": false,
          "legendFormat": "{{pool}} available",
          "range": true,
          "refId": "B"
        }
